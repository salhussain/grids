# Control-plane database (platform: tenants, plans, identities, routing)
DATABASE_URL_PLATFORM=postgres://grids_owner:grids_owner@localhost:55432/grids_platform
# Shared tenant data cell (RLS). The app connects as the non-owner role so RLS is enforced.
DATABASE_URL_CELL_MIGRATOR=postgres://grids_owner:grids_owner@localhost:55432/grids_cell_1
DATABASE_URL_CELL_APP=postgres://grids_app:grids_app@localhost:55432/grids_cell_1
# Object storage (S3-compatible; SeaweedFS in dev)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=grids
S3_SECRET_KEY=gridssecret
S3_BUCKET=grids
API_PORT=4000
# Grids identity provider (apps/identity)
DATABASE_URL_IDENTITY=postgres://grids_owner:grids_owner@localhost:55432/grids_identity
DATABASE_URL_IDENTITY_APP=postgres://grids_app:grids_app@localhost:55432/grids_identity
IDENTITY_ISSUER=http://localhost:4100/oidc
IDENTITY_PORT=4100
IDENTITY_SERVICE_TOKEN=dev-service-token-change-me
IDENTITY_SECRET_KEY=dev-secret-key-32-bytes-change-me!!
IDENTITY_COOKIE_KEY=dev-cookie-key-change-me
API_AUDIENCE=urn:grids:api
# The platform admin created by `bootstrap-idp` (also used by the end-to-end tests). Choose your own password.
PLATFORM_ADMIN_EMAIL=admin@grids.local
PLATFORM_ADMIN_PASSWORD=change-me-before-first-run

WORKER_PORT=4200
STATUS_PORT=4300
WORKER_CONCURRENCY=4
# Mail: `log` keeps messages inside the platform (console › Email log).
# Production: an SMTP URL, e.g. smtps://user:pass@email-smtp.eu-west-1.amazonaws.com:465
SMTP_URL=log
# Identity emails relay through the platform API (`platform`) or go to an SMTP URL directly.
IDENTITY_MAIL=platform
# Behind a proxy (Caddy, a load balancer)? Set true so the API reads the visitor's address from X-Forwarded-For (public form limits use it).
# TRUST_PROXY=true
# The activity log records each visitor's address; it also records a place when the proxy in front sends one
# (Cloudflare cf-ipcountry/cf-ipcity, Vercel x-vercel-ip-*, CloudFront cloudfront-viewer-*). To look places up instead,
# set a lookup service with {ip} where the address goes. Off by default: addresses are not sent anywhere.
# GEOIP_URL=https://ipapi.co/{ip}/json/

# Datasets written in Python, R or JavaScript run in a separate process on the machine that runs the API.
# On by default in development, off in production. Run `pnpm --filter @grids/data warm` once on each such machine
# (it downloads pandas and numpy, because the script process cannot reach the network or write files).
# SCRIPTS_ENABLED=false
# JavaScript is fully sandboxed (QuickJS plus Node's permission model). Python and R run as WebAssembly with an empty
# environment and no network inside the process, which is not a security boundary: before running other people's code,
# put an operating system sandbox in front. This is a command that runs what follows it, e.g.
#   SCRIPT_SANDBOX_CMD="bwrap --unshare-net --ro-bind / / --tmpfs /tmp --dev /dev --proc /proc"
# SCRIPT_SANDBOX_CMD=

# GridPay (apps/pay): the payment service
DATABASE_URL_PAY=postgres://grids_owner:grids_owner@localhost:55432/grids_pay
DATABASE_URL_PAY_APP=postgres://grids_app:grids_app@localhost:55432/grids_pay
PAY_PORT=4400
# Where people's browsers reach GridPay's payment pages
PAY_PUBLIC_URL=http://localhost:4400
# Where the API reaches GridPay (private)
PAY_URL=http://localhost:4400
PAY_SERVICE_TOKEN=dev-pay-service-token-change-me
PAY_SECRET_KEY=dev-pay-secret-key-32-bytes-change-me!!
